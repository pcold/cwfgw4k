{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/statusline.sh\"",
    "padding": 0
  },
  "enabledMcpjsonServers": [
    "code-review-graph"
  ],
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git commit --amend*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * commit --amend*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * clean -fd*)",
      "Bash(git * push --force*)",
      "Bash(git * push -f*)",
      "Bash(git push * +*)",
      "Bash(rtk proxy *)",
      "Read(gradle/wrapper/gradle-wrapper.jar)"
    ],
    "allow": [
      "Bash(sed -n *)",
      "Bash(git status*)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git merge-base *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git ls-remote *)",
      "Bash(git check-ignore *)",
      "Bash(git grep *)",
      "Bash(git stash *)",
      "Bash(git mv *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git rm *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git rebase *)",
      "Bash(git --no-pager status*)",
      "Bash(git --no-pager log*)",
      "Bash(git --no-pager diff*)",
      "Bash(git --no-pager show*)",
      "Bash(gh pr *)",
      "Bash(gh api *)",
      "Bash(gh run *)",
      "Bash(gh repo *)",
      "Bash(gh auth *)",
      "Bash(npm ci*)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm view *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(./gradlew *)",
      "Bash(mkdir -p *)",
      "Bash(java -version)",
      "Bash(lsof -ti:8080)",
      "Bash(pkill -f cwfgw4k-all.jar)",
      "Bash(xargs -r kill)",
      "Bash(disown)",

      "Bash(gcloud run services describe *)",
      "Bash(gcloud run revisions list *)",
      "Bash(gcloud run revisions describe *)",
      "Bash(gcloud logging read *)",

      "Bash(rtk --version)",
      "Bash(rtk gain*)",
      "Bash(rtk discover*)",

      "Read(~/code/**)",
      "Read(~/.claude/**)",
      "Read(//private/tmp/**)",
      "Read(//tmp/**)",
      "Edit(~/code/cwfgw4k-wt/**)",
      "Edit(//private/tmp/claude-501/**)",

      "mcp__code-review-graph__get_minimal_context_tool",
      "mcp__code-review-graph__detect_changes_tool",
      "mcp__code-review-graph__get_review_context_tool",
      "mcp__code-review-graph__query_graph_tool",
      "mcp__code-review-graph__get_impact_radius_tool",
      "mcp__code-review-graph__get_affected_flows_tool",
      "mcp__code-review-graph__semantic_search_nodes_tool",
      "mcp__code-review-graph__traverse_graph_tool",
      "mcp__code-review-graph__get_architecture_overview_tool",
      "mcp__code-review-graph__list_communities_tool",
      "mcp__code-review-graph__get_community_tool",
      "mcp__code-review-graph__list_graph_stats_tool",
      "mcp__code-review-graph__list_flows_tool",
      "mcp__code-review-graph__get_flow_tool",
      "mcp__code-review-graph__find_large_functions_tool",
      "mcp__code-review-graph__get_hub_nodes_tool",
      "mcp__code-review-graph__get_bridge_nodes_tool",
      "mcp__code-review-graph__get_knowledge_gaps_tool",
      "mcp__code-review-graph__get_surprising_connections_tool",
      "mcp__code-review-graph__get_suggested_questions_tool",
      "mcp__code-review-graph__cross_repo_search_tool",
      "mcp__code-review-graph__list_repos_tool",
      "mcp__code-review-graph__get_wiki_page_tool",
      "mcp__code-review-graph__get_docs_section_tool",
      "mcp__code-review-graph__refactor_tool",

      "mcp__linear__get_issue",
      "mcp__linear__list_issues",
      "mcp__linear__save_issue",
      "mcp__linear__save_comment",
      "mcp__linear__list_projects",
      "mcp__linear__save_project",
      "mcp__linear__list_teams",
      "mcp__linear__list_issue_statuses",
      "mcp__linear__list_issue_labels"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; command -v code-review-graph >/dev/null 2>&1 || exit 0; git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph update --skip-flows --repo \"$(git rev-parse --show-toplevel 2>/dev/null)\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; command -v code-review-graph >/dev/null 2>&1 || exit 0; git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph status --repo \"$(git rev-parse --show-toplevel 2>/dev/null)\" || echo 'Not a git repo, skipping'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
