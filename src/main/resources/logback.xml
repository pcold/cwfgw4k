<configuration>
    <!--
      One stream, every level: severity travels in each line's JSON, not in the stream. Text output
      here, even for local runs, would put production back on stream-assigned severity.
    -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <encoder class="com.cwfgw.logging.CloudLoggingJsonEncoder"/>
    </appender>
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="io.netty" level="INFO"/>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
